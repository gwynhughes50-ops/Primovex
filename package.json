{
  "name": "primovex",
  "version": "0.15.41",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "version:sync": "node scripts/sync-version.mjs",
    "release:config": "node scripts/create-release-config.mjs",
    "release:check": "npm run version:sync && npm run build",
    "desktop:build": "npm run version:sync && tauri build",
    "android:init": "npm run tauri -- android init",
    "android:dev": "npm run tauri -- android dev",
    "android:dev:open": "npm run tauri -- android dev --open",
    "android:build:debug": "npm run tauri -- android build --debug",
    "android:build": "npm run tauri -- android build",
    "dev:android": "vite --mode android",
    "build:android": "vite build --mode android",
    "android:bootstrap": "powershell -ExecutionPolicy Bypass -File scripts/bootstrap-android.ps1",
    "test:orb-trust": "esbuild scripts/verify-orb-trust.mjs --bundle --platform=node --format=esm --alias:@=./src --banner:js=\"import { createRequire as __cr } from 'node:module'; const require = __cr(import.meta.url);\" --outfile=work/verify-orb-trust.bundle.mjs && node work/verify-orb-trust.bundle.mjs",
    "test:orb-actions": "esbuild scripts/verify-orb-actions.mjs --bundle --platform=node --format=esm --alias:@=./src --outfile=work/verify-orb-actions.bundle.mjs && node work/verify-orb-actions.bundle.mjs",
    "test:clinflow-intelligence": "node scripts/verify-clinflow-intelligence.mjs",
    "test:governed-audit": "node scripts/verify-governed-audit.mjs",
    "test:desktop-alerts": "esbuild scripts/verify-desktop-alerts.mjs --bundle --platform=node --format=esm --outfile=work/verify-desktop-alerts.bundle.mjs && node work/verify-desktop-alerts.bundle.mjs",
    "test:stock-expiry": "esbuild scripts/verify-stock-expiry.mjs --bundle --platform=node --format=esm --outfile=work/verify-stock-expiry.bundle.mjs && node work/verify-stock-expiry.bundle.mjs",
    "test:org-chart": "node scripts/verify-org-chart.mjs",
    "test:checklist-kit": "esbuild scripts/verify-checklist-kit.mjs --bundle --platform=node --format=esm --outfile=work/verify-checklist-kit.bundle.mjs && node work/verify-checklist-kit.bundle.mjs",
    "test:stock-pickers": "esbuild scripts/verify-stock-pickers.mjs --bundle --platform=node --format=esm --outfile=work/verify-stock-pickers.bundle.mjs && node work/verify-stock-pickers.bundle.mjs",
    "test:stock-transfer": "esbuild scripts/verify-stock-transfer.mjs --bundle --platform=node --format=esm --outfile=work/verify-stock-transfer.bundle.mjs && node work/verify-stock-transfer.bundle.mjs",
    "test:site-link": "esbuild scripts/verify-site-link.mjs --bundle --platform=node --format=esm --outfile=work/verify-site-link.bundle.mjs && node work/verify-site-link.bundle.mjs",
    "test:mfa-helpers": "esbuild scripts/verify-mfa-helpers.mjs --bundle --platform=node --format=esm --outfile=work/verify-mfa-helpers.bundle.mjs && node work/verify-mfa-helpers.bundle.mjs",
    "test:stock-purge": "esbuild scripts/verify-stock-purge.mjs --bundle --platform=node --format=esm --outfile=work/verify-stock-purge.bundle.mjs && node work/verify-stock-purge.bundle.mjs",
    "test:role-presets": "esbuild scripts/verify-role-presets.mjs --bundle --platform=node --format=esm --outfile=work/verify-role-presets.bundle.mjs && node work/verify-role-presets.bundle.mjs",
    "test:hierarchy-edit": "esbuild scripts/verify-hierarchy-edit.mjs --bundle --platform=node --format=esm --outfile=work/verify-hierarchy-edit.bundle.mjs && node work/verify-hierarchy-edit.bundle.mjs",
    "test:notification-access": "esbuild scripts/verify-notification-access.mjs --bundle --platform=node --format=esm --alias:@=./src --outfile=work/verify-notification-access.bundle.mjs && node work/verify-notification-access.bundle.mjs",
    "test:due-text": "node scripts/verify-due-text.mjs",
    "test:asset-qr": "esbuild scripts/verify-asset-qr.mjs --bundle --platform=node --format=esm --alias:@=./src --outfile=work/verify-asset-qr.bundle.mjs && node work/verify-asset-qr.bundle.mjs"
  },
  "dependencies": {
    "@radix-ui/react-alert-dialog": "^1.1.15",
