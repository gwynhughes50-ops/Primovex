{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Primovex",
  "version": "0.14.3",
  "identifier": "uk.co.primovex.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Primovex",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "Primovex",
    "shortDescription": "Practice Operations Intelligence",
    "longDescription": "Primovex is an AI-assisted operational intelligence platform for primary care.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "category": "Business",
    "copyright": "\u00a9 2026 Primovex",
    "createUpdaterArtifacts": false,
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "primovex"
        ]
      },
      "mobile": [
        {
          "scheme": [
            "primovex"
          ],
          "appLink": false
        }
      ]
    }
  }
}
