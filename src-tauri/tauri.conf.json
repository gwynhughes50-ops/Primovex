{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Primovex",
  "version": "0.15.61",
  "identifier": "uk.co.primovex.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Primovex",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://firebasestorage.googleapis.com; font-src 'self' data:; connect-src 'self' https://*.googleapis.com https://europe-west2-medtrak-b1cad.cloudfunctions.net; object-src 'none'; base-uri 'self'; form-action 'self';"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "Primovex",
    "shortDescription": "Practice Operations Intelligence",
    "longDescription": "Primovex is an AI-assisted operational intelligence platform for primary care.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "category": "Business",
    "copyright": "© 2026 Primovex",
    "createUpdaterArtifacts": true,
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "primovex"
        ]
      },
      "mobile": [
        {
          "scheme": [
            "primovex"
          ],
          "appLink": false
        },
        {
          "scheme": [
            "https"
          ],
          "host": "app.primovex.co.uk",
          "pathPrefix": [
            "/sense/open"
          ],
          "appLink": true
        }
      ]
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEYxMjYzMzUwNDdBRjk4NkIKUldScm1LOUhVRE1tOGFkMzR1WE5MTlRrMXp3elhsME9Yd0g1MXdKVGN2WnVmWkdrakxJWW9xS2sK",
      "endpoints": [
        "https://medtrak-b1cad.web.app/updates/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
