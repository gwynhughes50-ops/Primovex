rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // -------------------------
    // Helpers
    // -------------------------
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return signedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "System Admin";
    }

    function userRole() {
      return signedIn()
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
        : null;
    }

    function isCaretaker() {
      return signedIn() && userRole() == "Caretaker";
    }

    function clinFlowReader() {
      return signedIn() && userRole() in ["System Admin", "Practice Manager", "User", "Nurse", "Reception", "ReadOnly"];
    }

    function clinFlowWorker() {
      return signedIn() && userRole() in ["System Admin", "Practice Manager", "User", "Nurse", "Reception"];
    }

    function clinFlowManager() {
      return signedIn() && userRole() in ["System Admin", "Practice Manager"];
    }

    function clinFlowPracticeMatches(practiceId) {
      return practiceId == "primary"
        || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.practiceId == practiceId
        || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.organisationId == practiceId
        || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.organizationId == practiceId;
    }

    // Audit evidence never uses the broad synthetic `primary` exception above.
    // A user may only read the exact tenant on their authenticated profile; the
    // primary fallback is accepted only for legacy single-practice profiles
    // which contain no explicit tenant identifier.
    function auditPracticeMatches(practiceId) {
      let profile = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      let tenant = profile.get("practiceId", profile.get("organisationId", profile.get("organizationId", "primary")));
      return signedIn() && practiceId == tenant;
    }

    // -------------------------
    // PER-USER SETTINGS
    // -------------------------
    match /user_settings/{uid} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid);
      allow update: if isOwner(uid);
      allow delete: if false;
    }

    // -------------------------
    // INVITES
    // -------------------------
    match /invites/{inviteId} {
      allow get: if resource.data.used == false
                 && resource.data.expiresAt > request.time;

      allow list: if isAdmin();
      allow create: if isAdmin();
      allow delete: if isAdmin();

      allow update: if isAdmin()
        || (
          signedIn()
          && resource.data.used == false
          && request.resource.data.used == true
          && request.resource.data.usedByUid == request.auth.uid
          && request.resource.data.email == resource.data.email
          && request.resource.data.role == resource.data.role
          && request.resource.data.displayName == resource.data.displayName
          && request.resource.data.createdBy == resource.data.createdBy
          && request.resource.data.expiresAt == resource.data.expiresAt
          && request.resource.data.createdAt == resource.data.createdAt
        );
    }

    // -------------------------
    // USERS (profiles)
    // -------------------------
    match /users/{uid} {
      // Concerns team members need to list staff by name to add someone as
      // involved on a case (see governance_concerns below) - narrow, direct
      // requirement rather than a general staff-directory widening.
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin() || hasPermission("governance", "concernsTeam"));

      // Self-created profiles (the invite/register flow) may only take the
      // lowest-privilege roles. Anything higher must go through the
      // admin-only createUserAccount Cloud Function, which writes via the
      // Admin SDK and bypasses these rules entirely.
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.role in ["User", "ReadOnly"];

      // user can update own profile but cannot change role
      allow update: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.role == resource.data.role;

      // admin can update/delete profiles
      allow update: if isAdmin();
      allow delete: if isAdmin();
      
           // -------------------------
      // PER-USER NOTIFICATIONS FEED (subcollection)
      // -------------------------
      match /notifications/{nid} {
        allow read: if isOwner(uid);

        // clients can't create notifications (Cloud Functions / Admin SDK bypasses rules)
        allow create: if false;

        // user can mark read, clear, etc.
        allow update: if isOwner(uid);
        allow delete: if isOwner(uid);
      }
    }

    // -------------------------
    // STOCK MOVEMENTS
    // -------------------------
    match /stock_movements/{docId} {
      allow get, list: if signedIn();
      allow create: if signedIn();
      // Historical movements are immutable except for the single controlled
      // transition that links an original stock-use entry to its compensating
      // reversal. No quantities, actor, reason or source fields can be edited.
      allow update: if signedIn()
        && !("reversed_at" in resource.data)
        && resource.data.type == "use"
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(["reversed_at", "reversed_by", "reversal_movement_id"])
        && request.resource.data.reversal_movement_id is string
        && request.resource.data.reversed_by is map
        && request.resource.data.reversed_by.uid == request.auth.uid;
      allow delete: if false;
    }
    match /stock_barcodes/{barcodeId} {
  allow read: if request.auth != null;
  allow create, update, delete: if request.auth != null;
}
  
  // -------------------------
// REORDER REQUESTS
// -------------------------
match /reorder_requests/{requestId} {
  allow get, list: if signedIn();
  allow create: if signedIn();
  allow update: if signedIn();
  allow delete: if isAdmin();
}

    // -------------------------
    // STOCK ITEMS
    // -------------------------
    match /stock_items/{docId} {
      allow get, list: if signedIn();
      allow create, update: if signedIn();
      allow delete: if isAdmin();
    }
    
    // -------------------------
// PURCHASE ORDERS
// -------------------------
match /purchase_orders/{orderId} {
  allow get, list: if signedIn();
  allow create, update: if signedIn();
  allow delete: if isAdmin();
}

// -------------------------
// PURCHASE ORDER ACTIVITY
// -------------------------
match /purchase_order_activity/{activityId} {
  allow get, list: if signedIn();
  allow create: if signedIn();
  allow update, delete: if isAdmin();
}
    
    // -------------------------
// SUPPLIERS
// -------------------------
match /suppliers/{supplierId} {
  allow get, list: if signedIn();
  allow create: if signedIn();
  allow update: if signedIn();
  allow delete: if isAdmin();
}

// -------------------------
// PRACTICE CONFIG
// -------------------------
match /practice_config/{docId} {
  allow get, list: if signedIn();
  allow create, update: if isAdmin();
  allow delete: if isAdmin();
}

// -------------------------
// CUSTOM ROLES (admin-defined, on top of the built-in ROLE_TEMPLATES)
// -------------------------
match /roles/{roleId} {
  allow get, list: if signedIn();
  allow create, update: if isAdmin();
  allow delete: if isAdmin();
}

// -------------------------
// PRACTICE SITES
// -------------------------
match /practice_sites/{siteId} {
  allow get, list: if signedIn();
  allow create, update: if isAdmin();
  allow delete: if isAdmin();
}

// -------------------------
// PRACTICE DEPARTMENTS
// -------------------------
match /practice_departments/{departmentId} {
  allow get, list: if signedIn();
  allow create, update: if isAdmin();
  allow delete: if isAdmin();
}

// -------------------------
// PRACTICE ROLES
// -------------------------
match /practice_roles/{roleId} {
  allow get, list: if signedIn();
  allow create, update: if isAdmin();
  allow delete: if isAdmin();
}


// -------------------------
// GOVERNANCE INTELLIGENCE - LISTENING TO PEOPLE CONCERNS
// -------------------------
// Three tiers: the Concerns team (a capability, not a role - can be layered
// onto anyone) has full read/write on every case. Partners (a dedicated
// role) can read every case but never write. Everyone else only sees a case
// if their uid is explicitly listed on it (involvedUserIds), and can only
// add a "note"-type timeline entry - never change the case itself.
function isConcernsTeam() {
  return isAdmin() || hasPermission("governance", "concernsTeam");
}
function isGovernancePartner() {
  return isAdmin() || hasPermission("governance", "partnerAccess");
}
function isInvolvedInConcern(concernData) {
  return signedIn() && request.auth.uid in (concernData.involvedUserIds != null ? concernData.involvedUserIds : []);
}

match /governance_concerns/{concernId} {
  allow get, list: if signedIn() && (isConcernsTeam() || isGovernancePartner() || isInvolvedInConcern(resource.data));
  allow create: if isConcernsTeam();
  allow update: if isConcernsTeam();
  allow delete: if isAdmin();
}

match /governance_concern_timeline/{timelineId} {
  allow get, list: if signedIn() && (
    isConcernsTeam() || isGovernancePartner()
    || isInvolvedInConcern(get(/databases/$(database)/documents/governance_concerns/$(resource.data.concernId)).data)
  );
  allow create: if signedIn() && (
    isConcernsTeam()
    || (
      isInvolvedInConcern(get(/databases/$(database)/documents/governance_concerns/$(request.resource.data.concernId)).data)
      && request.resource.data.type == "note"
    )
  );
  allow update, delete: if false;
}

match /governance_concern_learning_actions/{actionId} {
  allow get, list: if signedIn() && (
    isConcernsTeam() || isGovernancePartner()
    || isInvolvedInConcern(get(/databases/$(database)/documents/governance_concerns/$(resource.data.concernId)).data)
  );
  allow create, update: if isConcernsTeam();
  allow delete: if isAdmin();
}

match /governance_concern_correspondence/{entryId} {
  allow get, list: if signedIn() && (
    isConcernsTeam() || isGovernancePartner()
    || isInvolvedInConcern(get(/databases/$(database)/documents/governance_concerns/$(resource.data.concernId)).data)
  );
  allow create, update: if isConcernsTeam();
  allow delete: if isAdmin();
}

// -------------------------
// SAR GOVERNANCE COLLECTIONS (new module names)
// -------------------------
match /governance_sars/{sarId} {
  allow get, list: if signedIn();
  allow create, update: if signedIn();
  allow delete: if isAdmin();
}

match /governance_sar_activity/{activityId} {
  allow get, list: if signedIn();
  allow create: if signedIn();
  allow update, delete: if false;
}

// -------------------------
// SUBJECT ACCESS REQUESTS
// -------------------------
match /subject_access_requests/{requestId} {
  allow get, list: if signedIn();
  allow create, update: if signedIn();
  allow delete: if isAdmin();

  match /timeline/{timelineId} {
    allow get, list: if signedIn();
    allow create: if signedIn();
    allow update, delete: if isAdmin();
  }
}

    // -------------------------
    // TEMPERATURE LOGS
    // -------------------------
    match /temperature_logs/{docId} {
      allow get, list: if signedIn();
      allow create: if signedIn();
      allow update, delete: if isAdmin();
    }

    match /temperature_units/{docId} {
      allow get, list: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    match /temperature_incidents/{docId} {
      allow get, list: if signedIn();
      allow create: if signedIn();
      allow update: if signedIn();       // staff can resolve + add notes
      allow delete: if isAdmin();
    }

    // -------------------------
    // ALERT RESOLUTIONS
    // -------------------------
    match /alert_resolutions/{docId} {
      allow get, list: if signedIn();
      allow create, update: if signedIn();
      allow delete: if isAdmin();
    }

    // -------------------------
    // WATER TEMPS (Legionella)
    // -------------------------
    match /water_outlets/{docId} {
      allow get, list: if signedIn();
      allow create, update, delete: if isAdmin() || isCaretaker();
    }

    match /water_outlet_audit/{docId} {
      allow get, list: if isAdmin();
      allow create: if signedIn();
      allow update, delete: if false;
    }

    match /water_temp_rounds/{docId} {
      allow get, list: if signedIn();

      allow create: if signedIn()
        && request.resource.data.createdByUid == request.auth.uid;

      allow update: if isAdmin()
        || (
          signedIn()
          && resource.data.createdByUid == request.auth.uid
          && request.resource.data.createdByUid == resource.data.createdByUid
          && request.resource.data.createdAt == resource.data.createdAt
        );

      allow delete: if isAdmin();
    }

    // -------------------------
    // FIRE CHECKS + PAT
    // -------------------------
    match /fire_call_points/{docId} {
      allow get, list: if signedIn();
      allow create, update, delete: if isAdmin() || isCaretaker();
    }

    match /fire_weekly_checks/{docId} {
      allow get, list: if signedIn();
      allow create: if isAdmin() || isCaretaker();
      allow update, delete: if isAdmin();
    }

    match /pat_assets/{docId} {
      allow get, list: if signedIn();
      allow create, update, delete: if isAdmin() || isCaretaker();
    }

    match /pat_test_sessions/{docId} {
      allow get, list: if signedIn();
      allow create: if isAdmin() || isCaretaker();
      allow update, delete: if isAdmin();
    }



    // -------------------------
    // MEDTRAK CONNECT + PLATFORM AUDIT
    // -------------------------
    // Sprint 22: capability-aware access. Existing System Admin users continue
    // to work while we migrate user profiles to granular permissions maps.
    //
    // users/{uid}.permissions is actually a flat array of "domain.action"
    // capability strings (see capabilities.js's ROLE_TEMPLATES and
    // functions/index.js's own permission check), not a nested map — the
    // indexed-lookup version of this function below was checking a shape that
    // never existed, so it always fell through to isAdmin() alone. Fixed to
    // match the real shape; this only ever grants MORE access than before
    // (isAdmin() || <a check that used to always be false>), never less.
    function hasPermission(domain, action) {
      return signedIn()
        && (
          isAdmin()
          || (domain + "." + action) in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.permissions
          || "*" in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.permissions
        );
    }

    // -------------------------
    // SHARED SPACE REGISTRY
    // -------------------------
    // One live hierarchy is shared by Admin, Sense, Facilities and Mobile.
    match /space_registries/{registryId} {
      allow get, list: if signedIn();
      allow create, update: if isAdmin() || hasPermission("practiceAdmin", "write");
      allow delete: if isAdmin();
    }

    // Equipment registry — was localStorage-only, so equipment (fridges etc.)
    // added on one device never showed up on another. Same rule shape as
    // space_registries above, which this collection mirrors exactly.
    match /equipment_registry/{registryId} {
      allow get, list: if signedIn();
      allow create, update: if isAdmin() || hasPermission("practiceAdmin", "write");
      allow delete: if isAdmin();
    }

    // One doc per equipment item, written every time any staff phone's
    // background BLE scan passes near its tag. High write frequency by
    // design (last-seen-wins, no reconciliation needed), so this is
    // deliberately separate from equipment_registry's single shared doc.
    match /equipment_sightings/{equipmentId} {
      allow get, list: if signedIn();
      allow create, update: if signedIn();
      allow delete: if isAdmin();
    }

    match /connected_devices/{deviceId} {
      allow get, list: if signedIn() && (hasPermission("connect", "view") || isAdmin());
      allow create, update, delete: if hasPermission("connect", "manageDevices") || isAdmin();
    }

    // Non-secret Connect provider config (region/accessId/projectId/deviceId).
    // The Tuya Access Secret never touches Firestore or React — it only lives
    // in Firebase Functions secrets, read server-side by connectCloudHealth /
    // syncConnectProvider.
    match /connect_provider_settings/{settingsId} {
      allow get, list: if signedIn() && (hasPermission("connect", "view") || isAdmin());
      allow create, update: if signedIn() && (hasPermission("connect", "manageDevices") || isAdmin());
      allow delete: if isAdmin();
    }

    match /shelly_local_thermometers/{thermometerId} {
      allow get, list: if signedIn() && (hasPermission("connect", "view") || isAdmin());
      allow create, update, delete: if hasPermission("connect", "manageDevices") || isAdmin();
    }

    // Cleaning/stocking status per room, and the append-only log of cleaning
    // events. Low-sensitivity operational data (no PII) that any signed-in
    // staff member may need to write while physically doing the work (a
    // Cleaner scanning a tag, a nurse marking a room stocked), so this is
    // deliberately broader than the capability-gated collections above.
    match /room_operational/{roomId} {
      allow get, list, create, update: if signedIn();
      allow delete: if isAdmin();
    }

    // Orb phrase-learning suggestions. Every signed-in user's IntentEngine
    // reads the approved set on every request (list), and anyone can suggest
    // a phrase (create) via the clarification flow — but only an admin can
    // approve/reject one (update).
    match /orb_intent_learning/{suggestionId} {
      allow get, list, create: if signedIn();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Practice-taught FAQ/knowledge entries Orb matches against when no
    // structured tool applies. Any signed-in user can contribute a fact;
    // editing/removing an existing one is admin-gated to stop casual
    // overwrites of something someone else taught it.
    match /orb_knowledge_entries/{entryId} {
      allow get, list, create: if signedIn();
      allow update, delete: if isAdmin();
    }

    // Orb interaction audit trail. Write-only from the user's perspective —
    // an audit log a user could edit or read at will isn't a real audit log.
    match /orb_audit_log/{entryId} {
      allow create: if signedIn();
      allow get, list: if isAdmin();
      allow update: if false;
      allow delete: if isAdmin();
    }

    match /cleaning_logs/{logId} {
      allow get, list, create: if signedIn();
      allow update, delete: if isAdmin();
    }

    // Internal QA bug reports (mobile bug button + Developer Centre). No PII,
    // gated client-side to developer/admin roles, so this is deliberately
    // broad like room_operational above.
    match /developer_issues/{issueId} {
      allow get, list, create, update: if signedIn();
      allow delete: if isAdmin();
    }

    // Quick Notes. "private" notes are only visible to their author; "practice"
    // notes are visible to every signed-in user. A note can only ever be
    // authored as yourself, and only you (or an admin) can complete/delete it.
    match /quick_notes/{noteId} {
      allow get, list: if signedIn() && (resource.data.authorUid == request.auth.uid || resource.data.scope == "practice");
      allow create: if signedIn() && request.resource.data.authorUid == request.auth.uid;
      allow update, delete: if signedIn() && (resource.data.authorUid == request.auth.uid || isAdmin());
    }

    match /device_assignment_audit/{auditId} {
      allow get, list: if signedIn() && (hasPermission("audit", "read") || isAdmin());
      allow create: if signedIn() && (hasPermission("connect", "manageDevices") || isAdmin());
      allow update, delete: if false;
    }

    match /connect_device_readings/{readingId} {
      allow get, list: if signedIn() && (hasPermission("connect", "view") || isAdmin());
      // Real IoT ingestion should use Cloud Functions/Admin SDK. This client rule
      // supports simulation and testing during early hardware discovery.
      allow create: if signedIn() && (hasPermission("connect", "manageDevices") || isAdmin());
      allow update, delete: if false;
    }

    match /connect_device_alerts/{alertId} {
      allow get, list: if signedIn() && (hasPermission("connect", "view") || isAdmin());
      allow create: if signedIn() && (hasPermission("connect", "manageDevices") || isAdmin());
      allow update: if signedIn() && (hasPermission("connect", "acknowledgeAlerts") || isAdmin());
      allow delete: if isAdmin();
    }

    match /connect_locations/{locationId} {
      allow get, list: if signedIn() && (hasPermission("connect", "view") || isAdmin());
      allow create, update, delete: if hasPermission("connect", "manageDevices") || isAdmin();
    }

    match /audit_events/{eventId} {
      allow get, list: if signedIn()
        && (hasPermission("audit", "read") || isAdmin())
        && auditPracticeMatches(resource.data.practiceId);
      // The Admin SDK Cloud Function derives actor and tenant identity, writes
      // the sequence/hash chain and bypasses these client rules.
      allow create: if false;
      allow update, delete: if false;
    }

    match /audit_ledger_heads/{practiceId} {
      allow read, write: if false;
    }

    // -------------------------
    // CLINFLOW GOVERNED SYNTHETIC FOUNDATION
    // -------------------------
    // Only non-identifying demonstration workflow state can be written by a client.
    // Real documents and patient data require the future privileged ingestion gateway.
    // Azure analysis metadata is written by the Admin SDK only. The uploaded PDF
    // and extracted text are deliberately never stored in Firestore.
    match /clinflow_analysis_events/{eventId} {
      allow read, write: if false;
    }

    match /clinflow_workflow_records/{documentId} {
      allow get, list: if clinFlowReader()
        && resource.data.dataMode == "synthetic"
        && clinFlowPracticeMatches(resource.data.practiceId);

      allow create: if clinFlowWorker()
        && request.resource.data.dataMode == "synthetic"
        && request.resource.data.createdByUid == request.auth.uid
        && request.resource.data.keys().hasOnly([
          "schemaVersion", "dataMode", "practiceId", "siteId", "demoReference",
          "priority", "destination", "status", "archived",
          "patientVerificationStatus", "retentionClass", "createdByUid",
          "triageSuggestion", "triageDecision", "triageStatus", "triageRulesetVersion",
          "triageReviewedByUid", "triageReviewedAt",
          "claimedByUid", "claimedAt", "completedByUid", "completedAt",
          "archivedByUid", "archivedAt", "deleted", "deletedByUid", "deletedAt",
          "createdAt", "updatedAt", "updatedByUid"
        ])
        && clinFlowPracticeMatches(request.resource.data.practiceId);

      allow update: if clinFlowWorker()
        && resource.data.dataMode == "synthetic"
        && request.resource.data.dataMode == "synthetic"
        && request.resource.data.practiceId == resource.data.practiceId
        && request.resource.data.siteId == resource.data.siteId
        && request.resource.data.demoReference == resource.data.demoReference
        && request.resource.data.updatedByUid == request.auth.uid
        && (request.resource.data.archived == resource.data.archived || clinFlowManager())
        && clinFlowPracticeMatches(resource.data.practiceId);

      allow delete: if false;
    }

    match /clinflow_workflow_events/{eventId} {
      allow get, list: if clinFlowReader()
        && resource.data.dataMode == "synthetic"
        && clinFlowPracticeMatches(resource.data.practiceId);
      allow create: if clinFlowWorker()
        && request.resource.data.dataMode == "synthetic"
        && request.resource.data.actorUid == request.auth.uid
        && request.resource.data.keys().hasOnly([
          "schemaVersion", "dataMode", "practiceId", "siteId", "documentId",
          "type", "summary", "metadata", "actorUid", "createdAt"
        ])
        && clinFlowPracticeMatches(request.resource.data.practiceId);
      allow update, delete: if false;
    }



    // -------------------------
    // COMPLIANCE QR / NFC ENGINE
    // -------------------------
    match /compliance_assets/{assetId} {
      allow get, list: if signedIn() && (hasPermission("compliance", "read") || isCaretaker() || isAdmin());
      allow create, update: if signedIn() && (hasPermission("compliance", "manageAssets") || isCaretaker() || isAdmin());
      allow delete: if isAdmin();
    }

    match /compliance_checks/{checkId} {
      allow get, list: if signedIn() && (hasPermission("compliance", "read") || isCaretaker() || isAdmin());
      allow create: if signedIn() && (hasPermission("compliance", "recordChecks") || hasPermission("compliance", "read") || isCaretaker() || isAdmin());
      allow update, delete: if false; // compliance checks are immutable audit records
    }

    match /pulse_events/{eventId} {
      allow get, list: if signedIn() && (hasPermission("operations", "read") || hasPermission("compliance", "read") || isAdmin());
      allow create: if signedIn();
      allow update: if signedIn() && (hasPermission("operations", "manage") || hasPermission("compliance", "recordChecks") || isAdmin());
      allow delete: if isAdmin();
    }


    // -------------------------
    // PRIMOVEX SENSE SESSIONS
    // -------------------------
    match /device_sessions/{deviceId} {
      allow get, list: if signedIn();
      allow create, update: if signedIn();
      allow delete: if isAdmin();
    }

    match /device_session_events/{eventId} {
      allow get, list: if isAdmin() || (signedIn() && resource.data.replacementUserId == request.auth.uid);
      allow create: if signedIn();
      allow update, delete: if false;
    }

    match /sense_sessions/{sessionId} {
      allow get, list: if signedIn();
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if signedIn();
      allow delete: if isAdmin();
    }

    match /sense_events/{eventId} {
      allow get, list: if signedIn();
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }

    // -------------------------
    // SETTINGS
    // -------------------------
    match /settings/{docId} {
      allow get, list: if signedIn();
      allow create, update: if isAdmin();
      allow delete: if isAdmin();
    }

    // -------------------------
    // OPTIONAL legacy collection
    // -------------------------
    match /stockItems/{docId} {
      allow get, list: if signedIn();
      allow create, update: if signedIn();
      allow delete: if isAdmin();
    }
// -------------------------
// EMERGENCY DRUGS / EQUIPMENT (Monthly)
// -------------------------
match /emergency_assets/{assetId} {
  allow get, list: if signedIn();
  allow create, update, delete: if isAdmin();

  match /checks/{checkId} {
    allow get, list: if signedIn();
    allow create: if signedIn();
    allow update, delete: if false; // keep checks immutable
  }
}

// -------------------------
// ANAPHYLAXIS EMERGENCY BOXES (Monthly)
// -------------------------
match /anaphylaxis_boxes/{boxId} {
  allow get, list: if signedIn();
  allow create, update, delete: if isAdmin();

  match /checks/{checkId} {
    allow get, list: if signedIn();
    allow create: if signedIn();
    allow update, delete: if false; // keep checks immutable
  }
}
  }
}
